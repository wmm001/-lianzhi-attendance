# Copy to .env on the deployment host; do not commit the filled file.
APP_DOMAIN=attendance.example.com
DB_PASSWORD=replace-with-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-separate-long-root-password
REDIS_PASSWORD=replace-with-long-random-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters-for-hs256
BOOTSTRAP_ADMIN_PASSWORD=replace-with-unique-strong-admin-password
DEEPSEEK_API_KEY=

# Optional host ports for local Compose smoke tests; defaults are 80/443 and 8848/9848.
# WEB_HTTP_PORT=18080
# WEB_HTTPS_PORT=18443
# NACOS_HTTP_PORT=18848
# NACOS_GRPC_PORT=19848
